# ── Existing dashboard ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=            # server-only; required by the lead engine

# ── Lead engine: core ──
PUBLIC_BASE_URL=https://your-app.vercel.app   # public URL used in emails, booking links and Twilio webhooks
LEADS_SIGNING_SECRET=                 # long random string (openssl rand -hex 32) for booking/unsubscribe links
LEADS_INGEST_SECRET=                  # shared secret for POST /api/leads/ingest (x-leads-secret header)
CRON_SECRET=                          # Vercel cron bearer token for /api/cron/leads
LEADS_DEFAULT_COUNTRY_CODE=+91
LEADS_DEFAULT_LANGUAGE=en-IN

# ── Business context (used in AI emails, calls and scoring) ──
BUSINESS_NAME=KIIPL
AGENT_NAME=Riya
BUSINESS_PITCH=We help infrastructure and construction companies track site progress with live dashboards.
IDEAL_CUSTOMER_PROFILE=Construction, infrastructure or real-estate companies with active project sites and a budget for digital tools.
QUALIFY_MIN_SCORE=60

# ── Claude (extraction, multilingual emails, calling agent, qualification) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Email (any SMTP: Google Workspace, SES, SendGrid, Zoho, Resend SMTP...) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Riya at KIIPL <growth@yourdomain.com>"
EMAIL_REPLY_TO=
OUTREACH_MAX_EMAILS=3
OUTREACH_FOLLOW_UP_DAYS=3
OUTREACH_BATCH_SIZE=25

# ── Google service account (Calendar + Sheets) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_IMPERSONATE_USER=              # optional Workspace user (domain-wide delegation) → invites + Meet links
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Qualified Leads
BOOKING_TIMEZONE=Asia/Kolkata
BOOKING_START_HOUR=10
BOOKING_END_HOUR=18
BOOKING_SLOT_MINUTES=30
BOOKING_DAYS_AHEAD=7
BOOKING_WORKDAYS=1,2,3,4,5,6

# ── Twilio calling agent ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
CALL_MAX_TURNS=14
AUTO_CALL_AFTER_EMAIL=false
AUTO_CALL_AFTER_DAYS=2
MAX_CALL_ATTEMPTS=2

# ── Lead sources ──
META_VERIFY_TOKEN=                    # any string; paste the same value in the Meta webhook setup
META_APP_SECRET=                      # verifies X-Hub-Signature-256
META_PAGE_ACCESS_TOKEN=               # long-lived Page token with leads_retrieval
APIFY_TOKEN=
